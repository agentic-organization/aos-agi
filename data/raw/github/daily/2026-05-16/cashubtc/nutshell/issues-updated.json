    "title": "fix: UpdateQuoteTtl writes to quote TTL settings, not Redis cache TTL ",
    "user": {
      "login": "KvngMikey",
      "id": 74271024,
      "node_id": "MDQ6VXNlcjc0MjcxMDI0",
      "avatar_url": "https://avatars.githubusercontent.com/u/74271024?v=4",
