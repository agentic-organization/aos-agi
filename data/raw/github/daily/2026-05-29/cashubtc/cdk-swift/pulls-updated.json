    "title": "fix: pass --config to uniffi-bindgen so Swift module name is CashuDevKit",
    "user": {
      "login": "asmogo",
      "id": 175508099,
      "node_id": "U_kgDOCnYKgw",
      "avatar_url": "https://avatars.githubusercontent.com/u/175508099?v=4",
