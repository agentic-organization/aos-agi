    "pull_request": {
      "url": "https://api.github.com/repos/marmot-protocol/marmot/pulls/68",
      "html_url": "https://github.com/marmot-protocol/marmot/pull/68",
      "diff_url": "https://github.com/marmot-protocol/marmot/pull/68.diff",
      "patch_url": "https://github.com/marmot-protocol/marmot/pull/68.patch",
