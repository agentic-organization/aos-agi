    "pull_request": {
      "url": "https://api.github.com/repos/marmot-protocol/whitenoise/pulls/686",
      "html_url": "https://github.com/marmot-protocol/whitenoise/pull/686",
      "diff_url": "https://github.com/marmot-protocol/whitenoise/pull/686.diff",
      "patch_url": "https://github.com/marmot-protocol/whitenoise/pull/686.patch",
